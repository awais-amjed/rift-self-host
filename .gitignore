# Written by the console during setup; holds every secret the stack has.
.env

# Bind-mounted state. Postgres and object storage live in named volumes, but
# Caddy's certificates and the console's own config land here.
/volumes/

.DS_Store
*.swp

# The Supabase CLI's link state. Not the whole `supabase/` directory — that is
# where the endpoints live, and the layout the CLI deploys from.
supabase/.temp/

# Deno writes an npm cache beside each function when one is checked or run
# locally. The edge runtime resolves the same packages from `deno.lock`, and
# `COPY supabase/functions` would otherwise bake 33 MB of it into the image.
node_modules/
